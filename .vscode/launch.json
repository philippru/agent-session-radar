// Launch configurations for developing Session Radar.
// F5 builds the extension (watch task) and opens an "Extension Development Host" window.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			// Default (first entry = F5): opens the Dev Host with a real working folder, so the
			// extension can be tested against real Claude Code sessions. Session Radar itself reads
			// from ~/.claude; the folder only matters for the "current workspace only" filter.
			"name": "Run Extension (frnis-ai)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${userHome}/frnis.at/frnis-ai"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			// Asks for the folder. Note: if the input box loses focus, the launch is cancelled silently.
			"name": "Run Extension (Ordner wählen)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${input:devHostFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Run Extension (leeres Fenster)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	],
	"inputs": [
		{
			"id": "devHostFolder",
			"type": "promptString",
			"description": "Ordner, der im Extension Development Host geöffnet wird",
			"default": "C:\\Users\\phili\\frnis.at\\frnis-ai"
		}
	]
}
