// Launch configurations for developing Session Radar.
// F5 builds the extension (watch task) and opens an "Extension Development Host" window.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			// Default (first entry = F5): opens the Dev Host with this repository as its folder.
			// Session Radar itself reads from ~/.claude; the folder only matters for the
			// "current workspace only" filter.
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			// Asks for the folder. Note: if the input box loses focus, the launch is cancelled silently.
			"name": "Run Extension (choose folder)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${input:devHostFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Run Extension (empty window)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	],
	"inputs": [
		{
			"id": "devHostFolder",
			"type": "promptString",
			"description": "Folder to open in the Extension Development Host"
		}
	]
}
