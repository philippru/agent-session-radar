{
  "name": "session-radar",
  "displayName": "Session Radar",
  "description": "Overview of all your AI coding agent sessions (Claude Code, later Codex and others): what is running, what is waiting for you, what is done.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionRadar",
          "title": "Session Radar",
          "icon": "resources/radar.svg"
        }
      ]
    },
    "views": {
      "sessionRadar": [
        {
          "id": "sessionRadar.sessions",
          "name": "Sessions",
          "icon": "resources/radar.svg",
          "contextualTitle": "Session Radar"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sessionRadar.sessions",
        "contents": "No sessions found.\n[Refresh](command:sessionRadar.refresh)\nFor a more accurate live status (e.g. open permission prompts), you can add hooks to Claude Code:\n[Install Hooks…](command:sessionRadar.installHooks)"
      }
    ],
    "commands": [
      {
        "command": "sessionRadar.refresh",
        "title": "Refresh",
        "category": "Session Radar",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionRadar.scopeWorkspace",
        "title": "Show Current Workspace Only",
        "category": "Session Radar",
        "icon": "$(filter)"
      },
      {
        "command": "sessionRadar.scopeAll",
        "title": "Show All Projects",
        "category": "Session Radar",
        "icon": "$(filter-filled)"
      },
      {
        "command": "sessionRadar.markAllSeen",
        "title": "Mark All as Read",
        "category": "Session Radar",
        "icon": "$(check-all)"
      },
      {
        "command": "sessionRadar.showArchived",
        "title": "Show Archived Sessions",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.hideArchived",
        "title": "Hide Archived Sessions",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.installHooks",
        "title": "Install Claude Code Hooks…",
        "category": "Session Radar",
        "icon": "$(plug)"
      },
      {
        "command": "sessionRadar.uninstallHooks",
        "title": "Remove Claude Code Hooks…",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.open",
        "title": "Open / Resume",
        "category": "Session Radar",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sessionRadar.resumeInTerminal",
        "title": "Resume in Terminal",
        "category": "Session Radar",
        "icon": "$(terminal)"
      },
      {
        "command": "sessionRadar.rename",
        "title": "Rename (Local)…",
        "category": "Session Radar",
        "icon": "$(edit)"
      },
      {
        "command": "sessionRadar.markSeen",
        "title": "Mark as Read",
        "category": "Session Radar",
        "icon": "$(check)"
      },
      {
        "command": "sessionRadar.archive",
        "title": "Archive / Hide",
        "category": "Session Radar",
        "icon": "$(archive)"
      },
      {
        "command": "sessionRadar.unarchive",
        "title": "Unarchive",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.showTranscript",
        "title": "Show Transcript (Read-Only)",
        "category": "Session Radar",
        "icon": "$(file-text)"
      },
      {
        "command": "sessionRadar.revealTranscript",
        "title": "Reveal Transcript in File Explorer",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.copySessionId",
        "title": "Copy Session ID",
        "category": "Session Radar"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionRadar.markAllSeen",
          "when": "view == sessionRadar.sessions",
          "group": "navigation@0"
        },
        {
          "command": "sessionRadar.scopeWorkspace",
          "when": "view == sessionRadar.sessions && sessionRadar.scope != workspace",
          "group": "navigation@1"
        },
        {
          "command": "sessionRadar.scopeAll",
          "when": "view == sessionRadar.sessions && sessionRadar.scope == workspace",
          "group": "navigation@1"
        },
        {
          "command": "sessionRadar.refresh",
          "when": "view == sessionRadar.sessions",
          "group": "navigation@9"
        },
        {
          "command": "sessionRadar.showArchived",
          "when": "view == sessionRadar.sessions && !sessionRadar.showArchived",
          "group": "1_view@1"
        },
        {
          "command": "sessionRadar.hideArchived",
          "when": "view == sessionRadar.sessions && sessionRadar.showArchived",
          "group": "1_view@1"
        },
        {
          "command": "sessionRadar.installHooks",
          "when": "view == sessionRadar.sessions && !sessionRadar.hooksInstalled",
          "group": "2_hooks@1"
        },
        {
          "command": "sessionRadar.uninstallHooks",
          "when": "view == sessionRadar.sessions && sessionRadar.hooksInstalled",
          "group": "2_hooks@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionRadar.markSeen",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /reason=unread/",
          "group": "inline@1"
        },
        {
          "command": "sessionRadar.resumeInTerminal",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "inline@2"
        },
        {
          "command": "sessionRadar.open",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "1_open@1"
        },
        {
          "command": "sessionRadar.resumeInTerminal",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "1_open@2"
        },
        {
          "command": "sessionRadar.rename",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "2_edit@1"
        },
        {
          "command": "sessionRadar.markSeen",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /reason=unread/",
          "group": "2_edit@2"
        },
        {
          "command": "sessionRadar.archive",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /archived=0/",
          "group": "2_edit@3"
        },
        {
          "command": "sessionRadar.unarchive",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /archived=1/",
          "group": "2_edit@3"
        },
        {
          "command": "sessionRadar.showTranscript",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /transcript=1/",
          "group": "3_transcript@1"
        },
        {
          "command": "sessionRadar.revealTranscript",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /transcript=1/",
          "group": "3_transcript@2"
        },
        {
          "command": "sessionRadar.copySessionId",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "3_transcript@3"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionRadar.open",
          "when": "false"
        },
        {
          "command": "sessionRadar.resumeInTerminal",
          "when": "false"
        },
        {
          "command": "sessionRadar.rename",
          "when": "false"
        },
        {
          "command": "sessionRadar.markSeen",
          "when": "false"
        },
        {
          "command": "sessionRadar.archive",
          "when": "false"
        },
        {
          "command": "sessionRadar.unarchive",
          "when": "false"
        },
        {
          "command": "sessionRadar.showTranscript",
          "when": "false"
        },
        {
          "command": "sessionRadar.revealTranscript",
          "when": "false"
        },
        {
          "command": "sessionRadar.copySessionId",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Session Radar",
      "properties": {
        "sessionRadar.claudeDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Claude Code config folder. Empty = `$CLAUDE_CONFIG_DIR` or `~/.claude`."
        },
        "sessionRadar.maxAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Sessions whose transcript has not changed for more than this many days are ignored."
        },
        "sessionRadar.staleAfterHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "After this many hours without activity, a session counts as \"Stale\"."
        },
        "sessionRadar.runningTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "If a session reports \"running\" for this many minutes without new activity, it is considered stuck or done."
        },
        "sessionRadar.unreadAsWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Count finished responses you have not looked at yet as \"Waiting for me\"."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "tsc -p . --outDir out && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links -o session-radar.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "ai agents",
    "sessions"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
