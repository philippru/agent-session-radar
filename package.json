{
  "name": "session-radar",
  "displayName": "Session Radar",
  "description": "Übersicht über alle KI-Coding-Agent-Sessions (Claude Code, später Codex & Co.): was läuft, was wartet auf dich, was ist fertig.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionRadar",
          "title": "Session Radar",
          "icon": "resources/radar.svg"
        }
      ]
    },
    "views": {
      "sessionRadar": [
        {
          "id": "sessionRadar.sessions",
          "name": "Sessions",
          "icon": "resources/radar.svg",
          "contextualTitle": "Session Radar"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sessionRadar.sessions",
        "contents": "Keine Sessions gefunden.\n[Aktualisieren](command:sessionRadar.refresh)\nFür einen genaueren Live-Status (z. B. offene Freigaben) kannst du Hooks in Claude Code eintragen:\n[Hooks installieren…](command:sessionRadar.installHooks)"
      }
    ],
    "commands": [
      {
        "command": "sessionRadar.refresh",
        "title": "Aktualisieren",
        "category": "Session Radar",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionRadar.scopeWorkspace",
        "title": "Nur aktuellen Workspace zeigen",
        "category": "Session Radar",
        "icon": "$(filter)"
      },
      {
        "command": "sessionRadar.scopeAll",
        "title": "Alle Projekte zeigen",
        "category": "Session Radar",
        "icon": "$(filter-filled)"
      },
      {
        "command": "sessionRadar.markAllSeen",
        "title": "Alle als gelesen markieren",
        "category": "Session Radar",
        "icon": "$(check-all)"
      },
      {
        "command": "sessionRadar.showArchived",
        "title": "Archivierte Sessions einblenden",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.hideArchived",
        "title": "Archivierte Sessions ausblenden",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.installHooks",
        "title": "Claude-Code-Hooks installieren…",
        "category": "Session Radar",
        "icon": "$(plug)"
      },
      {
        "command": "sessionRadar.uninstallHooks",
        "title": "Claude-Code-Hooks entfernen…",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.open",
        "title": "Öffnen / Fortsetzen",
        "category": "Session Radar",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sessionRadar.resumeInTerminal",
        "title": "Im Terminal fortsetzen",
        "category": "Session Radar",
        "icon": "$(terminal)"
      },
      {
        "command": "sessionRadar.rename",
        "title": "Umbenennen (lokal)…",
        "category": "Session Radar",
        "icon": "$(edit)"
      },
      {
        "command": "sessionRadar.markSeen",
        "title": "Als gelesen markieren",
        "category": "Session Radar",
        "icon": "$(check)"
      },
      {
        "command": "sessionRadar.archive",
        "title": "Archivieren / Ausblenden",
        "category": "Session Radar",
        "icon": "$(archive)"
      },
      {
        "command": "sessionRadar.unarchive",
        "title": "Wiederherstellen",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.showTranscript",
        "title": "Transkript anzeigen (schreibgeschützt)",
        "category": "Session Radar",
        "icon": "$(file-text)"
      },
      {
        "command": "sessionRadar.revealTranscript",
        "title": "Transkript im Explorer zeigen",
        "category": "Session Radar"
      },
      {
        "command": "sessionRadar.copySessionId",
        "title": "Session-ID kopieren",
        "category": "Session Radar"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionRadar.markAllSeen",
          "when": "view == sessionRadar.sessions",
          "group": "navigation@0"
        },
        {
          "command": "sessionRadar.scopeWorkspace",
          "when": "view == sessionRadar.sessions && sessionRadar.scope != workspace",
          "group": "navigation@1"
        },
        {
          "command": "sessionRadar.scopeAll",
          "when": "view == sessionRadar.sessions && sessionRadar.scope == workspace",
          "group": "navigation@1"
        },
        {
          "command": "sessionRadar.refresh",
          "when": "view == sessionRadar.sessions",
          "group": "navigation@9"
        },
        {
          "command": "sessionRadar.showArchived",
          "when": "view == sessionRadar.sessions && !sessionRadar.showArchived",
          "group": "1_view@1"
        },
        {
          "command": "sessionRadar.hideArchived",
          "when": "view == sessionRadar.sessions && sessionRadar.showArchived",
          "group": "1_view@1"
        },
        {
          "command": "sessionRadar.installHooks",
          "when": "view == sessionRadar.sessions && !sessionRadar.hooksInstalled",
          "group": "2_hooks@1"
        },
        {
          "command": "sessionRadar.uninstallHooks",
          "when": "view == sessionRadar.sessions && sessionRadar.hooksInstalled",
          "group": "2_hooks@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionRadar.markSeen",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /reason=unread/",
          "group": "inline@1"
        },
        {
          "command": "sessionRadar.resumeInTerminal",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "inline@2"
        },
        {
          "command": "sessionRadar.open",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "1_open@1"
        },
        {
          "command": "sessionRadar.resumeInTerminal",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "1_open@2"
        },
        {
          "command": "sessionRadar.rename",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "2_edit@1"
        },
        {
          "command": "sessionRadar.markSeen",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /reason=unread/",
          "group": "2_edit@2"
        },
        {
          "command": "sessionRadar.archive",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /archived=0/",
          "group": "2_edit@3"
        },
        {
          "command": "sessionRadar.unarchive",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /archived=1/",
          "group": "2_edit@3"
        },
        {
          "command": "sessionRadar.showTranscript",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /transcript=1/",
          "group": "3_transcript@1"
        },
        {
          "command": "sessionRadar.revealTranscript",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/ && viewItem =~ /transcript=1/",
          "group": "3_transcript@2"
        },
        {
          "command": "sessionRadar.copySessionId",
          "when": "view == sessionRadar.sessions && viewItem =~ /^session;/",
          "group": "3_transcript@3"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionRadar.open",
          "when": "false"
        },
        {
          "command": "sessionRadar.resumeInTerminal",
          "when": "false"
        },
        {
          "command": "sessionRadar.rename",
          "when": "false"
        },
        {
          "command": "sessionRadar.markSeen",
          "when": "false"
        },
        {
          "command": "sessionRadar.archive",
          "when": "false"
        },
        {
          "command": "sessionRadar.unarchive",
          "when": "false"
        },
        {
          "command": "sessionRadar.showTranscript",
          "when": "false"
        },
        {
          "command": "sessionRadar.revealTranscript",
          "when": "false"
        },
        {
          "command": "sessionRadar.copySessionId",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Session Radar",
      "properties": {
        "sessionRadar.claudeDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Claude-Code-Konfigurationsordner. Leer = `$CLAUDE_CONFIG_DIR` bzw. `~/.claude`."
        },
        "sessionRadar.maxAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Sessions, deren Transkript länger als so viele Tage nicht geändert wurde, werden ignoriert."
        },
        "sessionRadar.staleAfterHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Ab so vielen Stunden ohne Aktivität gilt eine Session als \"Alt\"."
        },
        "sessionRadar.runningTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Meldet eine Session so lange \"läuft\" ohne neue Aktivität, gilt sie als hängengeblieben bzw. fertig."
        },
        "sessionRadar.unreadAsWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Fertige, noch nicht angesehene Antworten als \"Wartet auf mich\" zählen."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "tsc -p . --outDir out && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "package:vsix": "vsce package --no-dependencies --skip-license --allow-missing-repository --no-rewrite-relative-links -o session-radar.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "ai agents",
    "sessions"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
